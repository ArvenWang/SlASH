    "test": "vitest run",
    "test:baseline": "vitest run tests/gameplay-baseline.test.ts",
    "verify:full-run": "node validation/tools/capture-full-run.mjs",
    "verify:gameplay": "node validation/tools/run-gameplay-acceptance.mjs",
    "verify:input": "node validation/tools/profile-input-latency.mjs",
    "verify:lifecycle": "node validation/tools/verify-lifecycle-stability.mjs",
    "verify:memory": "node validation/tools/profile-memory-stability.mjs",
    "verify:performance": "node validation/tools/profile-acceptance-performance.mjs",
    "verify:performance-report": "node validation/tools/evaluate-performance-report.mjs",
    "verify:raf-baseline": "node validation/tools/profile-raf-baseline.mjs",
    "verify:browsers": "node validation/tools/verify-browser-matrix.mjs",
    "verify:audio": "node validation/tools/capture-audio-evidence.mjs",
    "verify:characters": "node validation/tools/verify-character-providers.mjs",
    "verify:character-assets": "node validation/tools/inspect-glb-character-assets.mjs",
    "verify:labs": "node validation/tools/verify-presentation-labs.mjs",
    "verify:assets": "node validation/tools/audit-runtime-assets.mjs",
    "verify:full-game-design": "node validation/tools/verify-full-game-design.mjs",
    "verify:encounters": "node validation/tools/generate-encounter-content-report.mjs",
    "verify:bosses": "node validation/tools/generate-boss-report.mjs",
    "verify:bosses:browser": "node validation/tools/verify-boss-practice.mjs",
    "verify:profile-protocol": "node validation/tools/verify-profile-protocol-ui.mjs",
    "verify:pause-touch": "node validation/tools/verify-pause-touch-summary.mjs"
